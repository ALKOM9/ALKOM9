# ========================================
# הגדרות אייג'נט AI לוואצאפ
# ========================================

# מפתח API של Groq (חינמי! 14,400 בקשות ביום)
# קבל אותו בחינם מ: https://console.groq.com
GROQ_API_KEY=your_api_key_here

# שם הבוט (אופציונלי)
BOT_NAME=עוזר AI

# תמונת פרופיל (אופציונלי - URL לתמונה, או שים קובץ profile.jpg בתיקייה)
# PROFILE_PICTURE_URL=https://example.com/photo.jpg

# האם לענות בקבוצות? (true/false)
# false = רק הודעות פרטיות
# true = גם בקבוצות
RESPOND_IN_GROUPS=false
