# ========================================
# Aylin WhatsApp AI — הגדרות
# ========================================

# === AI Keys ===
# Claude (ראשי — עדיף)
ANTHROPIC_API_KEY=sk-ant-...

# Groq (גיבוי — חינמי)
GROQ_API_KEY=your_groq_key_here

# === Bot Settings ===
BOT_NAME=Aylin

# תמונת פרופיל (אופציונלי — URL, או שים profile.jpg בתיקייה)
# PROFILE_PICTURE_URL=https://example.com/photo.jpg

# האם לענות בקבוצות?
RESPOND_IN_GROUPS=false

# === Admin ===
# מספר הטלפון של המנהל (ללא + ורווחים, כגון: 972501234567)
# ADMIN_NUMBER=972501234567

# רשימת מספרים מותרים (מופרדים בפסיק)
# WHITELIST=972501234567,972509876543

# רשימת מספרים חסומים
# BLACKLIST=972509999999

# === Dashboard ===
DASHBOARD_ENABLED=false
DASHBOARD_PORT=3000
DASHBOARD_USER=admin
DASHBOARD_PASS=aylin123

# === External APIs (אופציונלי) ===
# WAQI_TOKEN=your_waqi_token   (איכות אוויר — בחינם ב waqi.info/api)
# STOCKROW_COOKIES=             (אם יש לך חשבון Stockrow)
