  "vocabulary_tiers": {
    "tier1": {
      "range": "1-1000",
      "frequency_label": "High-frequency core vocabulary",
      "target": "active by A2",
      "min_reviews": 5,
      "levels": ["A1.1", "A1.2", "A2"],
      "notes": "Includes greetings, numbers, colors, family, body, food, daily routines, basic adjectives/adverbs, question words, postpositions"
    },
    "tier2": {
      "range": "1001-3000",
      "frequency_label": "Mid-frequency functional vocabulary",
      "target": "active by B2",
      "min_reviews": 3,
      "levels": ["A2", "B1", "B2"],
      "notes": "Includes work/career, health, travel, media, emotions, opinions, abstract nouns, formal connectors, compound verb components"
    },
    "tier3": {
      "range": "3001-5000",
      "frequency_label": "Lower-frequency academic/literary vocabulary",
      "target": "receptive by C1",
      "min_reviews": 2,
      "levels": ["B2", "C1"],
      "notes": "Includes academic terms (araştırma, varsayım, kanıtlamak), literary expressions, archaic forms, domain-specific terminology, idiomatic expressions"
    }
  },
  "review_policies": {
    "forgotten_item": "If an item is forgotten at review Rn, reset to R1 and restart the schedule from that point",
    "easy_item": "If an item is answered correctly and quickly at Rn, skip to Rn+2",
    "hard_item": "If an item is answered correctly but with difficulty, keep normal schedule but add an extra mini-review at N+2 after the current review",
    "new_item_limit": "Maximum 8 new grammar items per lesson; maximum 15 new vocabulary items per lesson"
  },
